# Frontend Environment Configuration

# Mapbox Public Access Token (from https://account.mapbox.com/access-tokens/)
# Optional: If left blank, the app will run with the interactive satellite fallback canvas.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend API URL (Express default: http://localhost:5000, FastAPI: http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
